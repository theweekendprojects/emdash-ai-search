{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // src/astro ships as SOURCE (the .astro file can't be pre-compiled; the
  // consuming Astro site compiles it). Excluded from tsc so dist/ doesn't carry
  // a dist/astro/index.js whose `import "./ChatWidget.astro"` can't resolve.
  "exclude": ["node_modules", "dist", "src/astro"]
}
