---
/**
 * AI search chat widget — self-contained, dependency-free.
 *
 * Renders a floating chat button + panel that POSTs to the plugin's public
 * `chat` route and shows grounded answers with citations. No fetch code for the
 * site author: drop the block in the editor (or <ChatWidget /> in a template)
 * and it works.
 *
 * Props (from a Portable Text block `Astro.props.node`, or passed directly):
 *   - title        panel header (default "Ask about this site")
 *   - placeholder  input placeholder
 *   - welcome      first assistant bubble
 *   - collections  optional string[] to scope retrieval (maps to chat filters)
 *   - accent       accent color
 *   - mode         "floating" (default) | "inline"
 *   - endpoint     override the chat route (default the plugin's public route)
 */
const node = (Astro.props as any).node ?? Astro.props ?? {};
const title: string = node.title ?? "Ask about this site";
const placeholder: string = node.placeholder ?? "Type your question…";
const welcome: string = node.welcome ?? "Hi! Ask me anything about this site.";
const accent: string = node.accent ?? "#465fff";
const mode: "floating" | "inline" = node.mode === "inline" ? "inline" : "floating";
const endpoint: string = node.endpoint ?? "/_emdash/api/plugins/ai-search/chat";

// collections may arrive as a JSON string (from a text_input field) or array.
let collections: string[] = [];
if (Array.isArray(node.collections)) collections = node.collections.map(String);
else if (typeof node.collections === "string" && node.collections.trim()) {
  try {
    const p = JSON.parse(node.collections);
    collections = Array.isArray(p) ? p.map(String) : node.collections.split(",").map((s: string) => s.trim()).filter(Boolean);
  } catch {
    collections = node.collections.split(",").map((s: string) => s.trim()).filter(Boolean);
  }
}

// Streaming endpoint (native builds only). Derived from `endpoint` unless the
// caller overrides it. The widget tries this first and falls back to `endpoint`
// (single-response) if it 404s or doesn't stream — so it works in both modes.
const streamEndpoint: string = node.streamEndpoint ?? endpoint.replace(/\/chat$/, "/chat/stream");

// A unique id lets multiple widgets coexist on one page.
const uid = "aisearch-chat-" + Math.random().toString(36).slice(2, 10);
const config = JSON.stringify({ endpoint, streamEndpoint, collections });
---

<div
  class:list={["aisearch-chat", mode === "inline" ? "aisearch-chat--inline" : "aisearch-chat--floating"]}
  id={uid}
  data-config={config}
  style={`--aisearch-chat-accent:${accent}`}
>
  {mode === "floating" && (
    <button type="button" class="aisearch-chat__launch" aria-label="Open chat" data-role="launch">
      💬
    </button>
  )}

  <div class="aisearch-chat__panel" data-role="panel" hidden={mode === "floating"}>
    <div class="aisearch-chat__header">
      <span>{title}</span>
      {mode === "floating" && (
        <button type="button" class="aisearch-chat__close" aria-label="Close chat" data-role="close">✕</button>
      )}
    </div>

    <div class="aisearch-chat__log" data-role="log" aria-live="polite">
      <div class="aisearch-chat__msg aisearch-chat__msg--bot">{welcome}</div>
    </div>

    <form class="aisearch-chat__form" data-role="form">
      <input
        type="text"
        class="aisearch-chat__input"
        data-role="input"
        placeholder={placeholder}
        autocomplete="off"
        aria-label="Your question"
      />
      <button type="submit" class="aisearch-chat__send" data-role="send">Send</button>
    </form>
  </div>
</div>

<style>
  .aisearch-chat { --aisearch-chat-accent: #465fff; font-family: system-ui, sans-serif; }
  .aisearch-chat--floating { position: fixed; right: 20px; bottom: 20px; z-index: 9999; }
  .aisearch-chat__launch {
    width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--aisearch-chat-accent); color: #fff; font-size: 24px; box-shadow: 0 4px 16px rgba(0,0,0,.2);
  }
  .aisearch-chat__panel {
    display: flex; flex-direction: column; width: 360px; max-width: calc(100vw - 40px);
    height: 480px; max-height: calc(100vh - 120px);
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,.18);
  }
  .aisearch-chat--floating .aisearch-chat__panel { position: fixed; right: 20px; bottom: 88px; }
  .aisearch-chat--inline .aisearch-chat__panel { position: relative; width: 100%; height: 520px; }
  .aisearch-chat__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; background: var(--aisearch-chat-accent); color: #fff; font-weight: 600; font-size: 14px;
  }
  .aisearch-chat__close { background: transparent; border: none; color: #fff; cursor: pointer; font-size: 16px; }
  .aisearch-chat__log { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: #fbfaf6; }
  .aisearch-chat__msg { padding: 9px 12px; border-radius: 12px; font-size: 14px; line-height: 1.45; max-width: 85%; white-space: pre-wrap; }
  .aisearch-chat__msg--bot { background: #fff; border: 1px solid #e5e7eb; align-self: flex-start; }
  .aisearch-chat__msg--user { background: var(--aisearch-chat-accent); color: #fff; align-self: flex-end; }
  .aisearch-chat__cite { font-size: 11px; color: #6b7280; align-self: flex-start; margin-top: -4px; }
  .aisearch-chat__cite a { color: #6b7280; }
  .aisearch-chat__form { display: flex; gap: 8px; padding: 10px; border-top: 1px solid #e5e7eb; background: #fff; }
  .aisearch-chat__input { flex: 1; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; }
  .aisearch-chat__send { padding: 9px 14px; border: none; border-radius: 8px; background: var(--aisearch-chat-accent); color: #fff; cursor: pointer; font-size: 14px; }
  .aisearch-chat__send:disabled { opacity: .6; cursor: default; }
</style>

<script is:inline define:vars={{ uid }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const cfg = JSON.parse(root.getAttribute("data-config") || "{}");
    const endpoint = cfg.endpoint;
    const streamEndpoint = cfg.streamEndpoint;
    const collections = Array.isArray(cfg.collections) ? cfg.collections : [];

    const q = (sel) => root.querySelector(`[data-role="${sel}"]`);
    const panel = q("panel"), log = q("log"), form = q("form"), input = q("input"), send = q("send");
    const launch = q("launch"), close = q("close");
    const isFloating = root.classList.contains("aisearch-chat--floating");

    function show() { if (panel) panel.hidden = false; if (launch) launch.style.display = "none"; }
    function hide() { if (panel) panel.hidden = true; if (launch) launch.style.display = ""; }
    if (launch) launch.addEventListener("click", show);
    if (close) close.addEventListener("click", hide);

    function bubble(text, who) {
      const el = document.createElement("div");
      el.className = "aisearch-chat__msg aisearch-chat__msg--" + who;
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }
    function citations(list) {
      if (!list || !list.length) return;
      const el = document.createElement("div");
      el.className = "aisearch-chat__cite";
      el.textContent = "Sources: " + list.map((c) => c.title).filter(Boolean).join(", ");
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
    }

    // Try SSE streaming (native builds); return true on success, false to fall back.
    async function tryStream(body, thinking) {
      if (!streamEndpoint) return false;
      let res;
      try {
        res = await fetch(streamEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "text/event-stream" },
          body: JSON.stringify(body),
        });
      } catch {
        return false;
      }
      const ctype = res.headers.get("content-type") || "";
      // Not a stream (sandboxed build wraps JSON, or route missing) → fall back.
      if (!res.ok || !res.body || !ctype.includes("text/event-stream")) return false;

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = "", acc = "";
      thinking.textContent = "";
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let i;
        while ((i = buf.indexOf("\n\n")) !== -1) {
          const evt = buf.slice(0, i); buf = buf.slice(i + 2);
          const line = evt.split("\n").find((l) => l.startsWith("data:"));
          if (!line) continue;
          const payload = line.slice(5).trim();
          if (payload === "[DONE]") { return true; }
          try {
            const obj = JSON.parse(payload);
            if (obj.delta) { acc += obj.delta; thinking.textContent = acc; log.scrollTop = log.scrollHeight; }
            else if (obj.error) { thinking.textContent = obj.error; return true; }
          } catch { /* ignore keep-alive/non-json */ }
        }
      }
      // If nothing streamed, treat as failure so we fall back.
      return acc.length > 0;
    }

    // Single-response fallback (sandboxed build, or if streaming unavailable).
    async function single(body, thinking) {
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        const payload = data && data.data ? data.data : data; // tolerate { success, data }
        thinking.textContent = payload && payload.answer ? payload.answer : (payload && payload.error) || "Sorry, something went wrong.";
        if (payload && payload.citations) citations(payload.citations);
      } catch {
        thinking.textContent = "Network error — please try again.";
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = (input.value || "").trim();
      if (!question) return;
      bubble(question, "user");
      input.value = "";
      send.disabled = true;
      const thinking = bubble("…", "bot");
      try {
        const body = { question };
        if (collections.length) body.filters = { collections };
        const streamed = await tryStream(body, thinking);
        if (!streamed) await single(body, thinking);
      } finally {
        send.disabled = false;
        input.focus();
      }
    });
  })();
</script>
