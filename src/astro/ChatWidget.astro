---
/**
 * AI search chat widget — powered by Deep Chat (MIT, framework-agnostic web
 * component, https://deepchat.dev).
 *
 * Renders a Deep Chat element wired to the plugin's public `chat` / `chat/stream`
 * routes via a custom `connect.handler`, mapping our `{answer, citations}` (and
 * SSE `{delta}` / `{citations}` events) onto Deep Chat's `signals` API. In
 * "floating" mode we wrap the element in our own launcher button + panel (Deep
 * Chat has no native floating launcher).
 *
 * Props (from a Portable Text block `Astro.props.node`, or passed directly):
 *   - title        panel header (default "Ask about this site")
 *   - placeholder  input placeholder            → Deep Chat textInput.placeholder
 *   - welcome      first assistant bubble        → Deep Chat introMessage
 *   - collections  optional string[] to scope retrieval (→ chat `filters`)
 *   - accent       accent color (hex)
 *   - mode         "floating" (default) | "inline"
 *   - endpoint     override the chat route (default the plugin's public route)
 *   - streamEndpoint override the streaming route (default {endpoint}/stream)
 */
const node = (Astro.props as any).node ?? Astro.props ?? {};
const title: string = node.title ?? "Ask about this site";
const placeholder: string = node.placeholder ?? "Type your question…";
const welcome: string = node.welcome ?? "Hi! Ask me anything about this site.";
const accent: string = node.accent ?? "#465fff";
const mode: "floating" | "inline" = node.mode === "inline" ? "inline" : "floating";
const endpoint: string = node.endpoint ?? "/_emdash/api/plugins/ai-search/chat";
const streamEndpoint: string =
  node.streamEndpoint ?? (endpoint.endsWith("/chat") ? endpoint + "/stream" : endpoint + "/chat/stream");

// collections may arrive as a JSON string (from a text_input field) or array.
let collections: string[] = [];
if (Array.isArray(node.collections)) collections = node.collections.map(String);
else if (typeof node.collections === "string" && node.collections.trim()) {
  try {
    const p = JSON.parse(node.collections);
    collections = Array.isArray(p)
      ? p.map(String)
      : node.collections.split(",").map((s: string) => s.trim()).filter(Boolean);
  } catch {
    collections = node.collections.split(",").map((s: string) => s.trim()).filter(Boolean);
  }
}

// A unique id lets multiple widgets coexist on one page.
const uid = "aisearch-chat-" + Math.random().toString(36).slice(2, 10);
const config = JSON.stringify({ endpoint, streamEndpoint, collections });
---

<!-- Load the Deep Chat custom element (client side, bundled by the site). -->
<script>
  import "deep-chat";
</script>

<div
  class:list={["aisearch-chat", mode === "inline" ? "aisearch-chat--inline" : "aisearch-chat--floating"]}
  id={uid + "-root"}
  data-uid={uid}
  data-config={config}
  style={`--aisearch-accent:${accent}`}
>
  {mode === "floating" && (
    <button type="button" class="aisearch-chat__launch" aria-label="Open chat" data-role="launch">
      💬
    </button>
  )}

  <div class="aisearch-chat__panel" data-role="panel" hidden={mode === "floating"}>
    <div class="aisearch-chat__header">
      <span>{title}</span>
      {mode === "floating" && (
        <button type="button" class="aisearch-chat__close" aria-label="Close chat" data-role="close">✕</button>
      )}
    </div>
    <!-- deep-chat is constructed in JS (see script) so `connect` is set BEFORE
         the element upgrades — otherwise Deep Chat starts in demo mode. -->
    <div class="aisearch-chat__mount" data-role="mount"
      data-welcome={welcome}
      data-placeholder={placeholder}
      data-accent={accent}
    ></div>
  </div>
</div>

<!--
  Deep Chat wiring. This runs in the BROWSER verbatim (define:vars forces
  is:inline), so it MUST be plain JavaScript — no TypeScript annotations.
-->
<script is:inline define:vars={{ uid }}>
  (function () {
    var root = document.getElementById(uid + "-root");
    if (!root) return;
    var mount = root.querySelector('[data-role="mount"]');
    if (!mount) return;

    var cfg = {};
    try {
      cfg = JSON.parse(root.getAttribute("data-config") || "{}");
    } catch (e) {
      cfg = {};
    }
    var endpoint = cfg.endpoint;
    var streamEndpoint = cfg.streamEndpoint;
    var collections = Array.isArray(cfg.collections) ? cfg.collections : [];

    // Floating launcher open/close/toggle.
    var launch = root.querySelector('[data-role="launch"]');
    var close = root.querySelector('[data-role="close"]');
    var panel = root.querySelector('[data-role="panel"]');
    function open() {
      if (panel) panel.hidden = false;
      root.classList.add("is-open");
    }
    function hide() {
      if (panel) panel.hidden = true;
      root.classList.remove("is-open");
    }
    if (launch) launch.addEventListener("click", function () {
      if (panel && panel.hidden) open();
      else hide();
    });
    if (close) close.addEventListener("click", hide);

    // Pull the latest user text out of Deep Chat's request body
    // ({messages: [{role, text}, ...]}).
    function questionFrom(body) {
      var msgs = body && body.messages;
      if (!Array.isArray(msgs) || msgs.length === 0) return "";
      for (var i = msgs.length - 1; i >= 0; i--) {
        if (msgs[i] && typeof msgs[i].text === "string" && msgs[i].text.trim()) {
          return msgs[i].text.trim();
        }
      }
      return "";
    }

    function citationsMarkdown(citations) {
      if (!Array.isArray(citations) || citations.length === 0) return "";
      var parts = citations
        .filter(function (c) { return c && c.title; })
        .map(function (c) { return String(c.title); });
      if (parts.length === 0) return "";
      return "\n\nSources: " + parts.join(", ");
    }

    // Attempt SSE streaming; returns true if it produced output, false to fall back.
    function tryStream(reqBody, signals) {
      if (!streamEndpoint) return Promise.resolve(false);
      return fetch(streamEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "text/event-stream" },
        body: JSON.stringify(reqBody),
      }).then(function (res) {
        var ctype = res.headers.get("content-type") || "";
        if (!res.ok || !res.body || ctype.indexOf("text/event-stream") === -1) return false;

        signals.onOpen();
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var buf = "";
        var produced = false;

        function pump() {
          return reader.read().then(function (r) {
            if (r.done) return produced;
            buf += decoder.decode(r.value, { stream: true });
            var idx;
            while ((idx = buf.indexOf("\n\n")) !== -1) {
              var evt = buf.slice(0, idx);
              buf = buf.slice(idx + 2);
              var dataLine = null;
              var lines = evt.split("\n");
              for (var i = 0; i < lines.length; i++) {
                if (lines[i].indexOf("data:") === 0) { dataLine = lines[i]; break; }
              }
              if (!dataLine) continue;
              var payload = dataLine.slice(5).trim();
              if (payload === "[DONE]") { return produced; }
              try {
                var obj = JSON.parse(payload);
                if (obj.delta) {
                  produced = true;
                  signals.onResponse({ text: obj.delta }); // stream mode appends
                } else if (obj.citations) {
                  var md = citationsMarkdown(obj.citations);
                  if (md) { produced = true; signals.onResponse({ text: md }); }
                } else if (obj.error) {
                  signals.onResponse({ error: String(obj.error) });
                  return true;
                }
              } catch (e) {
                // ignore keep-alives / non-JSON frames
              }
            }
            return pump();
          });
        }
        return pump();
      }).catch(function () {
        return false;
      });
    }

    // Non-streaming fallback: POST /chat, map {answer, citations}.
    function singleResponse(reqBody, signals) {
      return fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(reqBody),
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (json) {
          // EmDash wraps route results as { success, data }.
          var payload = json && json.data ? json.data : json;
          if (!res.ok || (json && json.success === false)) {
            var msg =
              (payload && payload.error && (payload.error.message || payload.error)) ||
              (res.status === 429 ? "Too many requests — please slow down." :
               res.status === 403 ? "This chat only works from the site itself." :
               "Sorry, something went wrong.");
            signals.onResponse({ error: String(msg) });
            return;
          }
          if (payload && payload.answer) {
            signals.onResponse({ text: payload.answer + citationsMarkdown(payload.citations) });
          } else if (payload && payload.error) {
            signals.onResponse({ error: String(payload.error.message || payload.error) });
          } else {
            signals.onResponse({ error: "Sorry, something went wrong." });
          }
        });
      }).catch(function () {
        signals.onResponse({ error: "Network error — please try again." });
      });
    }

    // Deep Chat v1.x uses the `request` property (with a `handler`) plus a
    // separate top-level `stream` property. (The `connect` property in the
    // current deepchat.dev docs is a newer API not present in v1.4.x — using it
    // leaves the component in demo mode. Verified against the installed
    // custom-elements.json: fields are `request` + `stream`, no `connect`.)
    var requestConfig = {
      handler: function (body, signals) {
        var question = questionFrom(body);
        if (!question) {
          signals.onResponse({ error: "Please type a question." });
          return;
        }
        var reqBody = { question: question };
        if (collections.length) reqBody.filters = { collections: collections };

        tryStream(reqBody, signals)
          .then(function (streamed) {
            if (streamed) {
              signals.onClose();
              return;
            }
            // Streaming unavailable/empty → single-shot request.
            return singleResponse(reqBody, signals).then(function () {
              signals.onClose();
            });
          })
          .catch(function () {
            signals.onResponse({ error: "Sorry, something went wrong." });
            signals.onClose();
          });
      },
    };

    // Build the deep-chat element in JS and set `request`/`stream` + config
    // BEFORE it is appended/upgraded. Deep Chat binds its message service at
    // upgrade; reassigning request afterwards is ignored and it stays in demo
    // mode. Constructing it here guarantees the request handler wins.
    function mountChat() {
      var chat = document.createElement("deep-chat");
      chat.id = uid;
      chat.className = "aisearch-chat__deepchat";
      chat.request = requestConfig;
      // Real SSE streaming does not survive EmDash's route layer (it wraps the
      // raw Response into a JSON envelope, so the stream body is lost — verified
      // live: /chat/stream returns application/json {"success":true,"data":{}}).
      // So we fetch the single /chat response in the handler and let Deep Chat
      // *simulate* streaming for a progressive typing effect.
      chat.stream = { simulation: true };
      chat.introMessage = { text: mount.getAttribute("data-welcome") || "" };
      chat.textInput = { placeholder: { text: mount.getAttribute("data-placeholder") || "" } };
      var accent = mount.getAttribute("data-accent") || "#465fff";
      chat.style.cssText =
        "--deep-chat-accent-color:" + accent +
        ";border:none;width:100%;height:100%;background-color:transparent;";
      mount.appendChild(chat);
    }
    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined("deep-chat").then(mountChat);
    } else {
      mountChat();
    }
  })();
</script>

<style>
  .aisearch-chat--floating {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9999;
  }

  .aisearch-chat__launch {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: var(--aisearch-accent, #465fff);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .aisearch-chat--floating.is-open .aisearch-chat__launch {
    display: none;
  }

  /* The `hidden` attribute must win over the `display:flex` panel rules below,
     otherwise the (fixed-position) panel keeps intercepting clicks even when
     "closed" and the launcher can't be reached. */
  .aisearch-chat__panel[hidden] {
    display: none !important;
  }

  .aisearch-chat--floating .aisearch-chat__panel {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 360px;
    max-width: calc(100vw - 40px);
    height: 480px;
    max-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    border: 1px solid #e5e7eb;
    background: #fff;
  }

  .aisearch-chat--inline .aisearch-chat__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 520px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    background: #fff;
  }

  .aisearch-chat__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--aisearch-accent, #465fff);
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    flex: 0 0 auto;
  }

  .aisearch-chat__close {
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    padding: 2px 6px;
  }

  .aisearch-chat__mount {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
  }

  .aisearch-chat__deepchat {
    flex: 1 1 auto;
    min-height: 0;
    /* Readable colors on both light and dark host themes: the panel forces a
       light surface, so keep Deep Chat text dark regardless of site theme. */
    --deep-chat-text-color: #1f2937;
    --deep-chat-background-color: #ffffff;
  }
</style>
