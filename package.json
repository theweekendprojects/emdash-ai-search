{
  "name": "emdash-ai-search",
  "version": "0.4.0",
  "description": "AI search + chat for EmDash CMS, powered by Cloudflare AI Search. Indexes your content into an AI Search instance (built-in storage, per-file, on publish) and injects Cloudflare's public-endpoint UI snippets (chat bubble / search modal / chat page) site-wide — no custom chat UI to maintain, minimal setup. Native-first (tokenless via the AI Search binding); an optional sandboxed REST build is at the ./sandbox entry.",
  "type": "module",
  "plugin": {
    "id": "ai-search"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./admin": {
      "import": "./dist/admin.js",
      "types": "./dist/admin.d.ts"
    },
    "./sandbox": "./dist/plugin.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:sandbox": "emdash-plugin build",
    "validate": "emdash-plugin validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "self-check": "tsx src/self-check.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@emdash-cms/plugin-cli": ">=0.1.0",
    "@emdash-cms/plugin-test": ">=0.1.0",
    "@rolldown/binding-darwin-x64": "1.0.0-rc.3",
    "emdash": ">=0.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "ai-search",
    "search",
    "semantic-search",
    "ai-chat",
    "cloudflare-ai-search",
    "autorag",
    "cms",
    "cms-plugin",
    "knowledge-base"
  ],
  "license": "MIT",
  "author": "Ported from SonicJS ai-search (lane711/sonicjs, MIT)"
}
