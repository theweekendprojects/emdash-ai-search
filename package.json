{
  "name": "@emdash/rag",
  "version": "0.4.0",
  "description": "Semantic search + RAG chat for EmDash CMS. Native-first (trusted): reaches Workers AI / AI Search / Vectorize / R2 through Cloudflare bindings, tokenless — installed via plugins:[rag()]. An optional sandboxed build (Cloudflare REST APIs over ctx.http, API-token config) is available at the ./sandbox entry. Ported from the SonicJS ai-search plugin (MIT).",
  "type": "module",
  "plugin": {
    "id": "rag"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./admin": {
      "import": "./dist/admin.js",
      "types": "./dist/admin.d.ts"
    },
    "./astro": "./src/astro/index.ts",
    "./components": "./src/astro/ChatWidget.astro",
    "./sandbox": "./dist/plugin.mjs"
  },
  "files": [
    "dist",
    "src/astro",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:sandbox": "emdash-plugin build",
    "validate": "emdash-plugin validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "self-check": "tsx src/self-check.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@emdash-cms/plugin-cli": ">=0.1.0",
    "@emdash-cms/plugin-test": ">=0.1.0",
    "@rolldown/binding-darwin-x64": "1.0.0-rc.3",
    "emdash": ">=0.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "rag",
    "search",
    "semantic-search",
    "vectorize",
    "workers-ai",
    "cms",
    "cms-plugin",
    "knowledge-base"
  ],
  "license": "MIT",
  "author": "Ported from SonicJS ai-search (lane711/sonicjs, MIT)"
}
