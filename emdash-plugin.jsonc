{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

  "slug": "ai-search",
  "publisher": "did:plc:REPLACE_WITH_YOUR_ATMOSPHERE_DID",

  "license": "MIT",
  "author": { "name": "Ported from SonicJS ai-search (lane711/sonicjs, MIT)" },
  "security": { "email": "security@example.com" },
  "description": "AI search + chat over your content, powered by Cloudflare AI Search. Indexes content into an AI Search instance (built-in storage, per file, on publish) and — in the native build — injects Cloudflare's public-endpoint UI snippets (chat bubble / search modal / chat page) site-wide. THIS manifest configures the SANDBOXED build (Cloudflare REST APIs over ctx.http); the native build (src/native.ts) uses the AI Search binding and is configured in astro.config.mjs.",

  // Capabilities for the SANDBOXED build:
  //   - content:read     → ctx.content.list()/get() to pull items to index
  //   - network:request  → ctx.http.fetch() to the Cloudflare AI Search REST API
  //                        (search + Items API), fenced to allowedHosts below.
  "capabilities": ["content:read", "network:request"],

  // ctx.http.fetch is fenced to these hosts (Cloudflare AI Search REST API).
  "allowedHosts": ["api.cloudflare.com"],

  // Plugin-scoped storage (no capability needed):
  //   - backfill_job: the durable, cron-drained backfill job (singleton)
  //   - doc_state:    per-doc content-hash for skip-unchanged during backfill
  "storage": {
    "backfill_job": { "indexes": ["phase", "updatedAt"] },
    "doc_state": { "indexes": ["collectionId", "indexedAt"] }
  },

  // The admin page ("/ai-search") is driven by the `admin` route (Block Kit): it
  // renders the settings form + index-status table + backfill actions. The
  // manifest schema (plugin-cli >=0.11) no longer accepts `settingsSchema`; all
  // settings are edited via the Block Kit form in the `admin` route, which
  // read/writes the same settings:* KV keys.
  "admin": {
    "pages": [{ "path": "/ai-search", "label": "AI Search", "icon": "magnifying-glass" }],
    "widgets": [{ "id": "ai-search-status", "title": "AI Search Index", "size": "half" }]
  }
}
